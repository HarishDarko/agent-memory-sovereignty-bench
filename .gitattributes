# Normalize line endings so SHA-256 integrity records stay reproducible.
#
# The frozen freeze/commitment records in this repository were computed from
# LF working-tree bytes. Forcing LF checkout for the recorded file types makes
# a fresh clone produce identical bytes on any platform (including Windows
# hosts whose Git defaults to CRLF conversions).

* text=auto
.python-version text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.jsonl text eol=lf
schemas/*.json text eol=lf
datasets/commitments/*.json text eol=lf
