# Normalize line endings so SHA-256 integrity records stay reproducible.
#
# The frozen freeze/commitment records in this repository were computed from
# CRLF working-tree bytes on the research machine. Forcing CRLF checkout for
# the recorded file types makes a fresh clone produce identical bytes on any
# platform. Unrecorded files (for example the LF-written analysis JSON under
# reports/) keep LF.

* text=auto
*.toml text eol=crlf
*.md text eol=crlf
*.py text eol=crlf
*.jsonl text eol=crlf
schemas/*.json text eol=crlf
datasets/commitments/*.json text eol=crlf
