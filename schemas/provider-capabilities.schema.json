{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovbench.local/schemas/provider-capabilities/1",
  "title": "Memory Sovereignty Benchmark provider adapter registration",
  "description": "Capability declaration and adapter metadata required before a provider can be registered or scored.",
  "type": "object",
  "required": ["capabilities", "meta"],
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supports_snapshot": {"type": "boolean"},
        "supports_restore": {"type": "boolean"},
        "supports_delete": {"type": "boolean"},
        "supports_export": {"type": "boolean"},
        "supports_import": {"type": "boolean"},
        "supports_restart": {"type": "boolean"},
        "read_only_retrieval": {"type": "boolean"},
        "uses_ground_truth": {"type": "boolean"},
        "network_required": {"type": "boolean"},
        "async_indexing": {"type": "boolean"}
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "name",
        "adapter_version",
        "upstream_version",
        "upstream_commit",
        "image_digest",
        "config_hash",
        "license",
        "telemetry",
        "external_dependencies",
        "network_needs"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "upstream_version": {"type": "string", "minLength": 1},
        "upstream_commit": {"type": "string", "minLength": 1},
        "image_digest": {"type": "string", "minLength": 1},
        "config_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "license": {"type": "string", "minLength": 1},
        "telemetry": {"enum": ["none", "disabled", "enabled"]},
        "external_dependencies": {"type": "array", "items": {"type": "string"}},
        "network_needs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
