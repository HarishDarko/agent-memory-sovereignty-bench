# AMSB environment template. Copy to .env or set in the shell; never commit
# real credentials. Offline mode needs none of these.

# Optional. Used only by the frozen DeepSeek reader path (exact AMSB
# Protocol v1 reproduction or new model-backed experiments). Not required for
# the smoke test, public DEV, or provider work.
SOVBENCH_DEEPSEEK_API_KEY=

# Optional gateway upstream override
SOVBENCH_PROTOCOL_UPSTREAM_URL=

# Hindsight server URL when using the pinned Docker stack
HINDSIGHT_API_URL=http://127.0.0.1:8000

# GBrain CLI locations (defaults resolve under the user home Bun install)
GBRAIN_BIN=
BUN_BIN=

# Optional Ollama local embeddings (research follow-up only)
OLLAMA_BASE_URL=http://127.0.0.1:4713/v1
OLLAMA_HOST=127.0.0.1:4713
